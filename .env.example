# Copy this file to .env.
# Allowed development hosts, separated by commas, without protocol or port.
# To access over the local network, add your machine's IP address (e.g., 127.0.0.1,192.168.1.100).
ALLOWED_DEV_ORIGINS=127.0.0.1

# Browser-accessible Spring Boot URL. Rebuild the frontend after changing it.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional: dev:back, dev:all and Playwright use this standalone checkout.
# BACKEND_DIR=../tic-tac-toe-backend
# Set to 1 to run Playwright against an already deployed test backend.
# E2E_EXTERNAL_BACKEND=1
